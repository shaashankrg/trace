ANTHROPIC_API_KEY=sk-ant-...
# Must accept temperature=0. The 5.x models (Opus 5.5, Sonnet 5.5, Haiku 5.5) reject it.
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=postgresql://kestrel:kestrel@localhost:5432/kestrel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CHUNK_SIZE=300
RETRIEVAL_TOP_K=4
RETRIEVAL_THRESHOLD=0.2
# Host port for Prometheus, if 9090 is taken (Pushgateway uses 9091)
PROMETHEUS_PORT=9090
OPENSEARCH_URL=http://localhost:9200
ASSISTANT_URL=http://localhost:8000
PUSHGATEWAY_URL=localhost:9091
